# Copied to /etc/payday-budget/payday-budget.env by install.sh, which fills in a
# generated PB_SECRET_KEY. That file is 0640 root:payday and is never overwritten
# by a later install or update.

PB_ENV=production
PB_DATA_DIR=/var/lib/payday-budget
PB_DATABASE_PATH=/var/lib/payday-budget/budget.db
PB_SECRET_KEY=replace-me
PB_BASE_URL=https://budget.example.com

# The NGINX Proxy Manager LXC's IP. uvicorn trusts forwarded headers only from here.
PB_TRUSTED_PROXY=127.0.0.1

PB_MAX_UPLOAD_MB=10
PB_BACKUP_KEEP_DAYS=14
